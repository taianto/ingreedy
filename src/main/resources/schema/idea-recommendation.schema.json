{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recommendation",
  "type": "object",
  "required": ["title", "nutritionTags", "ingredients", "recipe"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "nutritionTags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "grams", "preparation"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "grams": { "type": "number", "minimum": 0 },
          "preparation": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recipe": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
